# Local URL
# NEXT_PUBLIC_API_URL=http://192.168.1.12:5001/api
# NEXT_PUBLIC_API_URL=http://localhost:5001/api

# UAT URL
NEXT_PUBLIC_API_URL=https://api-uat.hunterx.co.in/api

# Production URL
# NEXT_PUBLIC_API_URL=https://api.hunterx.co.in/api

# Admin session cookies. Tokens are HttpOnly by default; set to false only to
# roll back to JS-readable cookies (proxy.ts rewrites existing cookies on the
# next page load either way, so switching signs nobody out).
# ADMIN_AUTH_COOKIES_HTTP_ONLY=false
